# Every header in this repository opens with `#pragma once`, so
# portability-avoid-pragma-once fires on all of them. Subtracting it here
# keeps the rest of portability-* useful.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-narrowing-conversions,
  google-explicit-constructor,
  modernize-use-nullptr,
  modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-const-return-type,
  readability-container-size-empty,
  readability-duplicate-include,
  readability-implicit-bool-conversion,
  readability-inconsistent-declaration-parameter-name,
  readability-redundant-*,
  readability-static-accessed-through-instance
WarningsAsErrors: ''
# Anchored on a directory the repository owns. An unanchored 'engine/.*' also
# matches the '-engine/' in this checkout's own root path, which let every
# fetched googletest header through the filter.
HeaderFilterRegex: '.*/(engine/include|apps|tests)/.*'
ExcludeHeaderFilterRegex: '.*/_deps/.*'
FormatStyle: file
