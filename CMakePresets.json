{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENGINE_BUILD_TESTS": true,
        "ENGINE_REQUIRE_VULKAN_SDK": true
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug (Wayland-first)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "ENGINE_PLATFORM_BACKEND": "WAYLAND",
        "ENGINE_ENABLE_SANITIZERS": false
      }
    },
    {
      "name": "windows-gcc-debug",
      "displayName": "Windows GCC Debug (MinGW)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "ENGINE_PLATFORM_BACKEND": "WIN32",
        "ENGINE_ENABLE_SANITIZERS": false
      }
    },
    {
      "name": "scaffold-no-vulkan",
      "displayName": "Scaffold structure check without Vulkan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_PLATFORM_BACKEND": "HEADLESS",
        "ENGINE_REQUIRE_VULKAN_SDK": false
      }
    },
    {
      "name": "linux-gcc-asan",
      "displayName": "Linux GCC Debug with AddressSanitizer and UBSan",
      "inherits": "linux-gcc-debug",
      "cacheVariables": {
        "ENGINE_ENABLE_SANITIZERS": true
      }
    },
    {
      "name": "docker-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "docker-linux-gcc-debug",
      "displayName": "Docker: Linux GCC Debug (Wayland-first)",
      "inherits": "docker-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "ENGINE_PLATFORM_BACKEND": "WAYLAND",
        "ENGINE_ENABLE_SANITIZERS": false
      }
    },
    {
      "name": "docker-linux-gcc-asan",
      "displayName": "Docker: Linux GCC Debug with AddressSanitizer and UBSan",
      "inherits": "docker-linux-gcc-debug",
      "cacheVariables": {
        "ENGINE_ENABLE_SANITIZERS": true
      }
    },
    {
      "name": "docker-windows-mingw-debug",
      "displayName": "Docker: Windows MinGW cross-compile Debug (scaffold-only)",
      "inherits": "docker-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_PLATFORM_BACKEND": "WIN32",
        "ENGINE_ENABLE_SANITIZERS": false,
        "ENGINE_REQUIRE_VULKAN_SDK": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-asan",
      "configurePreset": "linux-gcc-asan"
    },
    {
      "name": "windows-gcc-debug",
      "configurePreset": "windows-gcc-debug"
    },
    {
      "name": "scaffold-no-vulkan",
      "configurePreset": "scaffold-no-vulkan"
    },
    {
      "name": "docker-linux-gcc-debug",
      "configurePreset": "docker-linux-gcc-debug"
    },
    {
      "name": "docker-linux-gcc-asan",
      "configurePreset": "docker-linux-gcc-asan"
    },
    {
      "name": "docker-windows-mingw-debug",
      "configurePreset": "docker-windows-mingw-debug"
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-asan",
      "configurePreset": "linux-gcc-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-gcc-debug",
      "configurePreset": "windows-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "scaffold-no-vulkan",
      "configurePreset": "scaffold-no-vulkan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "docker-linux-gcc-debug",
      "configurePreset": "docker-linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "docker-linux-gcc-asan",
      "configurePreset": "docker-linux-gcc-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
