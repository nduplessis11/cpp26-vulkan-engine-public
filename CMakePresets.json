{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENGINE_BUILD_TESTS": true,
        "ENGINE_REQUIRE_VULKAN_SDK": true
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug (Wayland-first)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENGINE_PLATFORM_BACKEND": "WAYLAND",
        "ENGINE_ENABLE_SANITIZERS": false
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug (Wayland-first)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "ENGINE_PLATFORM_BACKEND": "WAYLAND",
        "ENGINE_ENABLE_SANITIZERS": false
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_PLATFORM_BACKEND": "WIN32",
        "ENGINE_ENABLE_SANITIZERS": false
      }
    },
    {
      "name": "scaffold-no-vulkan",
      "displayName": "Scaffold structure check without Vulkan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_PLATFORM_BACKEND": "HEADLESS",
        "ENGINE_REQUIRE_VULKAN_SDK": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "scaffold-no-vulkan",
      "configurePreset": "scaffold-no-vulkan"
    }
  ],
  "testPresets": [
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "scaffold-no-vulkan",
      "configurePreset": "scaffold-no-vulkan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
