include_guard(GLOBAL)
include(GoogleTest)

# Registers a GoogleTest binary with CTest, picking a registration strategy that
# survives the MinGW cross build.
#
# gtest_discover_tests() is the one you would reach for by default: it runs the
# freshly linked binary at build time and asks it to list its TEST() cases, so
# CTest sees one entry per test and picks up new cases with no CMake edit. Under
# the docker-windows-mingw-debug preset that is fatal, not degraded -- the build
# links version_gtest.exe and then tries to execute a Windows binary on the
# Linux build host:
#
#   CMake Error at GoogleTestAddTests.cmake:132 (message):
#     Error running test executable.
#       Path: '.../version_gtest.exe'
#
# gtest_add_tests() scans the source text for TEST() macros instead, so it never
# executes anything and cross-compiles fine. Its limitation is the flip side of
# that: it only sees test names spelled literally in the source, so TEST_P and
# TYPED_TEST instantiations, or tests generated by a macro, are invisible to it.
# Nothing in tests/ uses those today. If that changes, the fix is to install a
# CMAKE_CROSSCOMPILING_EMULATOR (wine) in the windows-mingw image so that
# gtest_discover_tests can run the binary again -- the image has no wine today.
#
# Tests are NOT run by the cross build either way; the mingw preset is
# build-only. Run the Windows binaries with the native windows-gcc-debug preset.
function(engine_add_gtest target)
    add_executable(${target} ${ARGN})

    # engine::runtime carries project_options and project_warnings, which is
    # where the C++26 standard, the -fcontracts debug flag, -lstdc++exp, and the
    # static MinGW runtime link options come from. GoogleTest's own targets do
    # not link it, so googletest is never compiled with this project's warning
    # set -- deliberate, since third-party warnings are not this repo's to fix.
    target_link_libraries(${target} PRIVATE engine::runtime GTest::gtest_main)

    if(CMAKE_CROSSCOMPILING)
        gtest_add_tests(TARGET ${target} TEST_LIST ${target}_cases)
    else()
        gtest_discover_tests(${target})
    endif()
endfunction()
