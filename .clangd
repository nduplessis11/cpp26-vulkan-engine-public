# clangd cannot find the compilation database on its own: it only searches the
# file's own directory, each ancestor, and a `build/` child of those. Our presets
# build out-of-source under out/build/<preset>/, so point clangd at one explicitly.
# Switch the path here when you switch presets.
CompileFlags:
  CompilationDatabase: out/build/linux-gcc-debug
  # clangd parses GCC's compilation database with Clang. Ignore GCC's contracts
  # flag here; the real build still gets it from cmake/Contracts.cmake.
  # Clang cannot parse contract syntax yet, so those expressions will still be
  # marked as errors in the editor.
  Remove:
    - -fcontracts
