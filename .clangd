# Point clangd to the preset's compilation database under out/build/.
# Update this path when switching presets; clangd does not find it automatically.
CompileFlags:
  CompilationDatabase: out/build/linux-gcc-debug
  # Clang rejects GCC's contracts flags.
  Remove:
    - -fcontract*
    - -fno-contract*
    # CLion can still inject GCC macros with use.predefines enabled. Keep
    # clion.clang.clangd.use.predefines=true and let Clang describe itself:
    # GCC's floating-point feature macros break libstdc++ <format> in clangd.
    - -imacros/clion_clangd_inmemory_directory/macros/*
    - -fgnuc-version=*
  # Clang cannot parse contract clauses. Erase them only in clangd's view.
  # Contract expressions receive no diagnostics or references here; GCC checks them.
  # These function-like macros also affect unrelated calls named pre or post.
  Add:
    - "-Dpre(...)="
    - "-Dpost(...)="
    - "-Dcontract_assert(...)=((void)0)"
