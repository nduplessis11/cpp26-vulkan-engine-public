# syntax=docker/dockerfile:1.7
# Build a GCC 17 / MinGW-w64 toolchain that runs on Linux and targets Windows.
# Order: binutils, MinGW headers, GCC stage 1, MinGW runtime and winpthreads,
# then GCC stage 2. docker/Dockerfile uses this image; see docs/BUILDING.md.
#
# GCC_SNAPSHOT pins a dated snapshot. MINGW_REF tracks master to include the
# __stack_chk_guard type fix (mingw-w64 commit 5d04f8f, GCC PR c/121911).
# Version 14.0.0 used void* where GCC 17 requires uintptr_t and failed to build.
# Rebuilding without cache can change the MinGW revision. Pin a release once
# one includes the fix.
FROM ubuntu:24.04

ARG TARGET=x86_64-w64-mingw32
ARG PREFIX=/usr/local
ARG BINUTILS_VERSION=2.45
ARG GCC_SNAPSHOT=17-20260727
ARG MINGW_REF=master
# Pin Vulkan headers for the target sysroot. This supplies neither a Windows
# import library nor vulkan-1.dll; see docker/Dockerfile's windows-mingw stage.
ARG VULKAN_HEADERS_REF=vulkan-sdk-1.4.357.0
# Ubuntu 24.04's CMake 3.28 rejects cxx_std_26 for these GCC versions.
# Pin 3.31.6, which recognizes support in GCC 16 and newer, including GCC 17 trunk.
ARG CMAKE_VERSION=3.31.6

ENV PATH=${PREFIX}/bin:${PATH} \
    CCACHE_DIR=/ccache \
    CCACHE_MAXSIZE=20G \
    HOME=/tmp

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        bison \
        build-essential \
        bzip2 \
        ca-certificates \
        ccache \
        curl \
        file \
        flex \
        gperf \
        git \
        libgmp-dev \
        libisl-dev \
        libmpc-dev \
        libmpfr-dev \
        libzstd-dev \
        make \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        texinfo \
        wget \
        xz-utils \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tmp/toolchain /workspace /ccache \
    && chmod 0777 /workspace /ccache

RUN curl --fail --location --retry 3 \
        "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
        --output /tmp/cmake.tar.gz \
    && tar -xzf /tmp/cmake.tar.gz -C ${PREFIX} --strip-components=1 \
    && rm /tmp/cmake.tar.gz \
    && cmake --version

WORKDIR /tmp/toolchain

RUN curl --fail --location --retry 3 \
        "https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VERSION}.tar.xz" \
        --output binutils.tar.xz \
    && tar -xf binutils.tar.xz \
    && mkdir build-binutils \
    && cd build-binutils \
    && ../binutils-${BINUTILS_VERSION}/configure \
        --prefix=${PREFIX} \
        --target=${TARGET} \
        --disable-multilib \
        --disable-lto \
        --disable-plugins \
        --disable-nls \
        --disable-werror \
        --with-system-zlib \
    && make -j"$(nproc)" \
    && make install

RUN curl --fail --location --retry 3 \
        "https://codeload.github.com/mingw-w64/mingw-w64/tar.gz/${MINGW_REF}" \
        --output mingw-w64.tar.gz \
    && tar -xf mingw-w64.tar.gz \
    && mv mingw-w64-* mingw-w64-src \
    && mkdir build-mingw-headers \
    && cd build-mingw-headers \
    && ../mingw-w64-src/mingw-w64-headers/configure \
        --prefix=${PREFIX}/${TARGET} \
        --host=${TARGET} \
        --enable-sdk=all \
    && make -j"$(nproc)" \
    && make install

RUN curl --fail --location --retry 3 \
        "https://gcc.gnu.org/pub/gcc/snapshots/${GCC_SNAPSHOT}/gcc-${GCC_SNAPSHOT}.tar.xz" \
        --output gcc.tar.xz \
    && tar -xf gcc.tar.xz \
    && mkdir build-gcc \
    && cd build-gcc \
    && ../gcc-${GCC_SNAPSHOT}/configure \
        --prefix=${PREFIX} \
        --target=${TARGET} \
        --enable-languages=c,c++ \
        --enable-threads=posix \
        --disable-multilib \
        --disable-lto \
        --disable-nls \
        --disable-shared \
        --enable-static \
        --disable-werror \
        --disable-libstdcxx-pch \
        --disable-libssp \
        --with-system-zlib \
    && make -j"$(nproc)" all-gcc \
    && make install-gcc

RUN mkdir build-mingw-crt \
    && cd build-mingw-crt \
    && ../mingw-w64-src/mingw-w64-crt/configure \
        --prefix=${PREFIX}/${TARGET} \
        --host=${TARGET} \
        --disable-lib32 \
        --enable-lib64 \
        --enable-wildcard \
    && (make -j"$(nproc)" || make -j1) \
    && make install

RUN mkdir build-winpthreads \
    && cd build-winpthreads \
    && ../mingw-w64-src/mingw-w64-libraries/winpthreads/configure \
        --prefix=${PREFIX}/${TARGET} \
        --host=${TARGET} \
        --disable-shared \
        --enable-static \
    && make -j"$(nproc)" \
    && make install

RUN cd build-gcc \
    && make -j"$(nproc)" \
    && make install \
    && ${TARGET}-g++ --version \
    && printf '#include <version>\nint main(){}\n' \
        | ${TARGET}-g++ -std=c++26 -x c++ - -c -o /tmp/cpp26-test.o \
    && rm -f /tmp/cpp26-test.o

# Copy headers last to preserve cached toolchain builds when updating the tag.
# Put them in the target sysroot so CMake's include search can find them.
RUN curl --fail --location --retry 3 \
        "https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/${VULKAN_HEADERS_REF}.tar.gz" \
        --output vulkan-headers.tar.gz \
    && tar -xzf vulkan-headers.tar.gz \
    && cp -r Vulkan-Headers-*/include/vulkan ${PREFIX}/${TARGET}/include/ \
    && cp -r Vulkan-Headers-*/include/vk_video ${PREFIX}/${TARGET}/include/ \
    && rm -rf /tmp/toolchain

WORKDIR /workspace
