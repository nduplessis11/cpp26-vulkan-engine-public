root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,c,cmake,md,json,yml,yaml,py,glsl,vert,frag,comp}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Matches ColumnLimit in .clang-format. Neovim sets textwidth from this. With
# textwidth 0, Vim's built-in formatting, such as gw, wraps at 79 columns.
[*.{cpp,hpp}]
max_line_length = 80
